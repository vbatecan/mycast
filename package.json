    "svelte": "^5.56.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "prettier": "^3",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
